BLOG_SITE_URL=https://blog.example.com
BLOG_AUTHOR=Your name
BLOG_NAME=7blog
BLOG_DESCRIPTION=Notes, projects, and other things.
# Host port bound on 127.0.0.1 only; your existing Caddy proxies to it.
BLOG_PORT=8080
# Public domain(s). localhost and 127.0.0.1 are always allowed for the health check.
BLOG_ALLOWED_HOSTS=blog.example.com
# Optional: proxy addresses whose X-Forwarded-For/Proto headers are trusted.
# The default network covers Docker's standard bridge ranges (172.16.0.0/12).
# BLOG_KNOWN_PROXY=127.0.0.1
# BLOG_TRUSTED_NETWORK=172.16.0.0/12
# Optional: existing Docker network shared with an existing Caddy container.
CADDY_NETWORK=caddy
