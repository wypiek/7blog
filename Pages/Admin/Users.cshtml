@page "/admin/users"
@model SevenBlog.Pages.Admin.UsersModel
@{ ViewData["Title"] = "Users — Admin panel"; }
<div class="heading-with-action admin-section-heading">
    <h2>Users</h2>
    <form action="/admin/users/new/" method="get"><button type="submit" class="default">New user…</button></form>
</div>
<div class="table-scroll has-scrollbar" role="region" aria-label="User accounts" tabindex="0">
    <table class="post-table admin-users">
        <thead><tr><th scope="col">Username</th><th scope="col">Display name</th><th scope="col">Rank</th><th scope="col">Status</th><th scope="col">Posts</th><th scope="col">Joined</th></tr></thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td><a href="/admin/users/@user.Id/">@user.Username</a></td>
                <td title="@user.DisplayName">@user.DisplayName</td>
                <td>@user.RankLabel</td>
                <td>@(user.Disabled ? "Disabled" : "Active")</td>
                <td>@Model.PostCounts.GetValueOrDefault(user.Id)</td>
                <td>@user.CreatedAt.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
            </tr>
        }
        </tbody>
    </table>
</div>
