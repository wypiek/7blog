@page "/search"
@model SearchModel
@{
    ViewData["Title"] = "Search";
    ViewData["NoIndex"] = true;
}
<header class="page-heading"><h1>Search</h1></header>
<form class="page-search" action="/search/" method="get" role="search">
    <label for="query">Search by title, topic, or article text</label>
    <div class="searchbox">
        <input id="query" type="search" name="q" value="@Model.Query" maxlength="200" />
        <button type="submit" aria-label="search"></button>
    </div>
</form>
<p class="search-status" role="status">
    @if (string.IsNullOrEmpty(Model.Query))
    {
        <text>Type a word or two and press Enter.</text>
    }
    else if (Model.Results.Count == 0)
    {
        <text>No posts found for “@Model.Query”. Try another search or <a href="/archive/">browse the archive</a>.</text>
    }
    else
    {
        <text>@Model.Results.Count @(Model.Results.Count == 1 ? "post" : "posts") found for “@Model.Query”.</text>
    }
</p>
<div class="post-list">
    @foreach (var post in Model.Results)
    {
        <partial name="_PostSummary" model="post" />
    }
</div>
